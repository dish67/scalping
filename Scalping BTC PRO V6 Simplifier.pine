//@version=5
strategy("Scalping BTC PRO V6 Simplifier",
     overlay=true,
     calc_on_every_tick=true,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=10,
     pyramiding=0,
     commission_type=strategy.commission.percent,
     commission_value=0.04,
     slippage=2,
     process_orders_on_close=true)

//====================================================
// INPUTS
//====================================================
emaFastLen = input.int(9, "EMA Rapide", minval=1)
emaSlowLen = input.int(21, "EMA Lente", minval=1)
emaTrendLen = input.int(200, "EMA Tendance", minval=1)

showSignals = input.bool(true, "Afficher croisements")
showBlockedCrosses = input.bool(false, "Afficher croisements bloques")
showInfoPanel = input.bool(true, "Afficher tableau")
showBackground = input.bool(true, "Colorer tendance")
signalHoldBars = input.int(10, "Garder signal dans tableau", minval=0)
// Mode immediat par defaut : le signal apparait pendant la bougie du croisement.
// Activer ces options pour attendre la cloture ou laisser les filtres se valider
// pendant les bougies suivantes (signal plus tardif, mais plus prudent).
confirmedSignalsOnly = input.bool(false, "Signaux seulement bougie cloturee")
useConfirmationWindow = input.bool(true, "Confirmer avec ecart EMA")
confirmationBars = input.int(5, "Fenetre confirmation", minval=0)
useContinuationSignals = input.bool(true, "Signaux continuation EMA")
continuationTolerancePct = input.float(0.05, "Tolerance pullback EMA (%)", minval=0.0, step=0.01)
continuationCooldownBars = input.int(20, "Cooldown continuation", minval=0)
minContinuationMovePct = input.float(0.25, "Mouvement mini depuis dernier signal (%)", minval=0.0, step=0.01)
maxContinuationSignalsPerTrend = input.int(1, "Max continuations par tendance", minval=0)
useContinuationBreakout = input.bool(true, "Continuation avec cassure recente")
continuationBreakoutLookback = input.int(8, "Lookback cassure continuation", minval=2)
useEmaSpreadFilter = input.bool(true, "Filtre anti-range: ecart EMA minimum")
minEmaSpreadPct = input.float(0.03, "Ecart EMA minimum (%)", minval=0.0, step=0.01)
useSlopeFilter = input.bool(true, "Filtre pente EMA")
slopeLookback = input.int(3, "Lookback pente EMA", minval=1)
minSlopePct = input.float(0.01, "Pente EMA minimum (%)", minval=0.0, step=0.01)
useTrendFilter = input.bool(true, "Filtre tendance EMA 200")
allowEarlyReversal = input.bool(true, "Retournement anticipe avant EMA 200")
useDowntrendBreakoutBuy = input.bool(true, "BUY sur cassure ligne baissiere")
trendlinePivotLen = input.int(3, "Force pivots ligne baissiere", minval=1)
trendlineRequireBullEma = input.bool(true, "Cassure: exiger EMA 9 > EMA 21")
useFastReversalBuy = input.bool(true, "BUY retournement haussier precoce")
fastReversalBars = input.int(8, "Fenetre retournement precoce", minval=1)
cooldownBars = input.int(5, "Cooldown entre signaux", minval=0)
enableStrategyOrders = input.bool(false, "Activer ordres strategie")
allowShorts = input.bool(true, "Autoriser shorts")
atrLen = input.int(14, "Risque: periode ATR", minval=1)
stopAtrMult = input.float(1.5, "Risque: stop ATR", minval=0.1, step=0.1)
rewardRiskRatio = input.float(2.0, "Risque: objectif R", minval=0.1, step=0.1)
useBreakEven = input.bool(true, "Risque: activer break-even")
breakEvenTriggerR = input.float(1.0, "Risque: break-even apres R", minval=0.1, step=0.1)
breakEvenOffsetTicks = input.int(2, "Risque: gain break-even (ticks)", minval=0)
useAtrTrailing = input.bool(false, "Risque: activer trailing ATR")
trailingTriggerR = input.float(1.5, "Risque: trailing apres R", minval=0.1, step=0.1)
trailingAtrMult = input.float(1.0, "Risque: distance trailing ATR", minval=0.1, step=0.1)
maxTradeBars = input.int(32, "Risque: sortie apres N bougies", minval=0)
panelCorner = input.string("Top Right", "Position tableau", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"])

//====================================================
// EMA 9 / EMA 21
//====================================================
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
emaTrend = ta.ema(close, emaTrendLen)

bullCrossRaw = ta.crossover(emaFast, emaSlow)
bearCrossRaw = ta.crossunder(emaFast, emaSlow)

bullTrend = emaFast > emaSlow
bearTrend = emaFast < emaSlow

emaDistancePct = ((emaFast - emaSlow) / emaSlow) * 100.0
emaSpreadPct = math.abs(emaDistancePct)
emaFastSlopePct = ((emaFast - emaFast[slopeLookback]) / emaFast[slopeLookback]) * 100.0

spreadOk = not useEmaSpreadFilter or emaSpreadPct >= minEmaSpreadPct
slopeLongOk = not useSlopeFilter or emaFastSlopePct >= minSlopePct
slopeShortOk = not useSlopeFilter or emaFastSlopePct <= -minSlopePct
trendLongOk = not useTrendFilter or close > emaTrend
trendShortOk = not useTrendFilter or close < emaTrend
confirmedOk = not confirmedSignalsOnly or barstate.isconfirmed

//====================================================
// SIGNAL FILTERS
//====================================================
var int lastSignalBar = na
var float lastSignalPrice = na
var int pendingDirection = 0
var int pendingCrossBar = na
var int continuationLongCount = 0
var int continuationShortCount = 0

if bullCrossRaw
    pendingDirection := 1
    pendingCrossBar := bar_index
    continuationLongCount := 0
    continuationShortCount := 0

if bearCrossRaw
    pendingDirection := -1
    pendingCrossBar := bar_index
    continuationLongCount := 0
    continuationShortCount := 0

pendingActive = useConfirmationWindow and not na(pendingCrossBar) and bar_index - pendingCrossBar <= confirmationBars
pendingBull = pendingActive and pendingDirection == 1 and bullTrend
pendingBear = pendingActive and pendingDirection == -1 and bearTrend

cooldownOk = cooldownBars == 0 or na(lastSignalBar) or bar_index - lastSignalBar >= cooldownBars
continuationCooldownOk = continuationCooldownBars == 0 or na(lastSignalBar) or bar_index - lastSignalBar >= continuationCooldownBars
moveFromLastSignalPct = na(lastSignalPrice) ? 999.0 : math.abs((close - lastSignalPrice) / lastSignalPrice) * 100.0
continuationMoveOk = moveFromLastSignalPct >= minContinuationMovePct
continuationLongCountOk = continuationLongCount < maxContinuationSignalsPerTrend
continuationShortCountOk = continuationShortCount < maxContinuationSignalsPerTrend

bullSetup = useConfirmationWindow ? pendingBull : bullCrossRaw
bearSetup = useConfirmationWindow ? pendingBear : bearCrossRaw

// Au moment exact du croisement, l'ecart entre les deux EMA est proche de zero.
// Le filtre d'ecart n'est donc applicable qu'au mode de confirmation differee.
crossSpreadOk = not useConfirmationWindow or spreadOk
// Le retournement reste autorise avant l'EMA 200, mais le mode de confirmation
// peut attendre que l'ecart EMA minimum soit atteint.
earlyBullReversal = allowEarlyReversal and bullSetup and not trendLongOk
earlyBearReversal = allowEarlyReversal and bearSetup and not trendShortOk
crossTrendLongOk = trendLongOk or earlyBullReversal
crossTrendShortOk = trendShortOk or earlyBearReversal

bullCross = bullSetup and confirmedOk and crossSpreadOk and slopeLongOk and crossTrendLongOk and cooldownOk
bearCross = bearSetup and confirmedOk and crossSpreadOk and slopeShortOk and crossTrendShortOk and cooldownOk

pullbackLong = low <= emaFast * (1 + continuationTolerancePct / 100.0) or low <= emaSlow * (1 + continuationTolerancePct / 100.0)
pullbackShort = high >= emaFast * (1 - continuationTolerancePct / 100.0) or high >= emaSlow * (1 - continuationTolerancePct / 100.0)
breakoutLongOk = not useContinuationBreakout or close > ta.highest(high, continuationBreakoutLookback)[1]
breakoutShortOk = not useContinuationBreakout or close < ta.lowest(low, continuationBreakoutLookback)[1]

bullContinuation = useContinuationSignals and not bullCross and bullTrend and pullbackLong and close > emaFast and close > open and confirmedOk and spreadOk and slopeLongOk and trendLongOk and cooldownOk and continuationCooldownOk and continuationMoveOk and continuationLongCountOk and breakoutLongOk
bearContinuation = useContinuationSignals and not bearCross and bearTrend and pullbackShort and close < emaFast and close < open and confirmedOk and spreadOk and slopeShortOk and trendShortOk and cooldownOk and continuationCooldownOk and continuationMoveOk and continuationShortCountOk and breakoutShortOk

// Ligne de tendance baissiere automatique construite avec les deux derniers
// sommets pivots. Pine Script ne peut pas lire les lignes dessinees manuellement.
pivotHigh = ta.pivothigh(high, trendlinePivotLen, trendlinePivotLen)
var int previousPivotHighBar = na
var float previousPivotHighPrice = na
var int latestPivotHighBar = na
var float latestPivotHighPrice = na
var line downtrendLine = na

if not na(pivotHigh)
    newPivotBar = bar_index - trendlinePivotLen
    newPivotPrice = pivotHigh
    if not na(latestPivotHighPrice) and newPivotPrice < latestPivotHighPrice
        previousPivotHighBar := latestPivotHighBar
        previousPivotHighPrice := latestPivotHighPrice
        latestPivotHighBar := newPivotBar
        latestPivotHighPrice := newPivotPrice
        if not na(downtrendLine)
            line.delete(downtrendLine)
        downtrendLine := line.new(previousPivotHighBar, previousPivotHighPrice, latestPivotHighBar, latestPivotHighPrice, extend=extend.right, color=color.white, width=2)
    else
        latestPivotHighBar := newPivotBar
        latestPivotHighPrice := newPivotPrice

downtrendPrice = not na(downtrendLine) ? line.get_price(downtrendLine, bar_index) : na
downtrendBreakoutBuy = useDowntrendBreakoutBuy and not na(downtrendPrice) and ta.crossover(close, downtrendPrice) and (not trendlineRequireBullEma or bullTrend) and confirmedOk and cooldownOk

// Signal plus reactif apres le croisement haussier. Contrairement au signal
// standard, il n'attend ni l'ecart EMA minimum ni le passage de l'EMA 200.
// Une bougie verte au-dessus de l'EMA rapide avec une EMA 9 montante confirme
// que le retournement commence reellement.
fastReversalActive = useFastReversalBuy and not na(pendingCrossBar) and pendingDirection == 1 and bar_index - pendingCrossBar <= fastReversalBars
fastReversalBuy = fastReversalActive and bullTrend and close > emaFast and close > open and emaFast > emaFast[1] and confirmedOk and cooldownOk

bullSignal = bullCross or bullContinuation or downtrendBreakoutBuy or fastReversalBuy
bearSignal = bearCross or bearContinuation

if bullSignal or bearSignal
    lastSignalBar := bar_index
    lastSignalPrice := close
    if bullContinuation
        continuationLongCount += 1
    if bearContinuation
        continuationShortCount += 1
    pendingDirection := 0
    pendingCrossBar := na

//====================================================
// LAST CROSS STATE
//====================================================
var string lastRawCrossText = "Aucun"
var color lastRawCrossColor = color.gray
var int lastRawCrossBar = na
var string lastCrossText = "Aucun"
var color lastCrossColor = color.gray
var int lastCrossBar = na

if bullCrossRaw
    lastRawCrossText := "Haussier"
    lastRawCrossColor := color.lime
    lastRawCrossBar := bar_index

if bearCrossRaw
    lastRawCrossText := "Baissier"
    lastRawCrossColor := color.red
    lastRawCrossBar := bar_index

if bullSignal
    lastCrossText := "Haussier"
    lastCrossColor := color.lime
    lastCrossBar := bar_index

if bearSignal
    lastCrossText := "Baissier"
    lastCrossColor := color.red
    lastCrossBar := bar_index

barsSinceRawCross = na(lastRawCrossBar) ? na : bar_index - lastRawCrossBar
lastRawCrossDisplay = na(barsSinceRawCross) ? lastRawCrossText : lastRawCrossText + " - " + str.tostring(barsSinceRawCross) + " barres"

trendText = bullTrend ? "Haussiere" : bearTrend ? "Baissiere" : "Neutre"
trendColor = bullTrend ? color.lime : bearTrend ? color.red : color.gray

signalText = bullSignal ? "BUY" : bearSignal ? "SELL" : "Attente"
signalColor = bullSignal ? color.lime : bearSignal ? color.red : color.gray
lastSignalDisplay = na(lastSignalBar) ? "Aucun" : lastCrossText + " - " + str.tostring(bar_index - lastSignalBar) + " barres"
lastSignalColor = na(lastSignalBar) ? color.gray : lastCrossColor
signalStillActive = not na(lastSignalBar) and bar_index - lastSignalBar <= signalHoldBars
panelSignalText = bullSignal or bearSignal ? signalText : signalStillActive ? lastSignalDisplay : "Attente"
panelSignalColor = bullSignal or bearSignal ? signalColor : signalStillActive ? lastSignalColor : color.gray

rawCrossNow = bullCrossRaw or bearCrossRaw
setupNow = bullSetup or bearSetup or bullContinuation or bearContinuation
validSignalNow = bullSignal or bearSignal
blockedBullCross = showBlockedCrosses and bullCrossRaw and not bullSignal
blockedBearCross = showBlockedCrosses and bearCrossRaw and not bearSignal

filterText = validSignalNow ? (downtrendBreakoutBuy ? "Cassure ligne baissiere" : fastReversalBuy ? "Retournement precoce" : earlyBullReversal or earlyBearReversal ? "Retournement anticipe" : "Signal valide") : setupNow and not crossSpreadOk ? "Range EMA" : setupNow and not cooldownOk ? "Cooldown" : bullSetup and not slopeLongOk ? "Pente faible" : bearSetup and not slopeShortOk ? "Pente faible" : bullSetup and not crossTrendLongOk ? "Sous EMA 200" : bearSetup and not crossTrendShortOk ? "Sur EMA 200" : setupNow and not confirmedOk ? "Bougie ouverte" : useContinuationBreakout and bullTrend and pullbackLong and not breakoutLongOk ? "Pas cassure" : useContinuationBreakout and bearTrend and pullbackShort and not breakoutShortOk ? "Pas cassure" : pendingActive ? "Cross en attente" : "Pret"
filterColor = validSignalNow ? signalColor : filterText == "Pret" ? color.lime : filterText == "Cross en attente" ? color.aqua : color.orange

//====================================================
// STRATEGY ORDERS
//====================================================
if enableStrategyOrders and bullSignal
    strategy.entry("LONG", strategy.long)

if enableStrategyOrders and bearSignal
    if allowShorts
        strategy.entry("SHORT", strategy.short)
    else
        strategy.close("LONG")

//====================================================
// GESTION DU RISQUE ET SORTIES DE BACKTEST
//====================================================
atrValue = ta.atr(atrLen)
var float entryRiskDistance = na
var float highestSinceEntry = na
var float lowestSinceEntry = na
var int tradeEntryBar = na
var bool breakEvenArmed = false
var bool trailingArmed = false

newLongPosition = strategy.position_size > 0 and strategy.position_size[1] <= 0
newShortPosition = strategy.position_size < 0 and strategy.position_size[1] >= 0

if newLongPosition or newShortPosition
    entryRiskDistance := atrValue * stopAtrMult
    highestSinceEntry := high
    lowestSinceEntry := low
    tradeEntryBar := bar_index
    breakEvenArmed := false
    trailingArmed := false

if strategy.position_size > 0
    highestSinceEntry := math.max(nz(highestSinceEntry, high), high)
    if useBreakEven and highestSinceEntry >= strategy.position_avg_price + entryRiskDistance * breakEvenTriggerR
        breakEvenArmed := true
    if useAtrTrailing and highestSinceEntry >= strategy.position_avg_price + entryRiskDistance * trailingTriggerR
        trailingArmed := true

if strategy.position_size < 0
    lowestSinceEntry := math.min(nz(lowestSinceEntry, low), low)
    if useBreakEven and lowestSinceEntry <= strategy.position_avg_price - entryRiskDistance * breakEvenTriggerR
        breakEvenArmed := true
    if useAtrTrailing and lowestSinceEntry <= strategy.position_avg_price - entryRiskDistance * trailingTriggerR
        trailingArmed := true

float activeStop = na
float activeTarget = na

if enableStrategyOrders and strategy.position_size > 0 and not na(entryRiskDistance)
    initialLongStop = strategy.position_avg_price - entryRiskDistance
    breakEvenLongStop = strategy.position_avg_price + breakEvenOffsetTicks * syminfo.mintick
    trailingLongStop = highestSinceEntry - atrValue * trailingAtrMult
    activeStop := breakEvenArmed ? math.max(initialLongStop, breakEvenLongStop) : initialLongStop
    activeStop := trailingArmed ? math.max(activeStop, trailingLongStop) : activeStop
    activeTarget := strategy.position_avg_price + entryRiskDistance * rewardRiskRatio
    strategy.exit("LONG EXIT", from_entry="LONG", stop=activeStop, limit=activeTarget)

if enableStrategyOrders and strategy.position_size < 0 and not na(entryRiskDistance)
    initialShortStop = strategy.position_avg_price + entryRiskDistance
    breakEvenShortStop = strategy.position_avg_price - breakEvenOffsetTicks * syminfo.mintick
    trailingShortStop = lowestSinceEntry + atrValue * trailingAtrMult
    activeStop := breakEvenArmed ? math.min(initialShortStop, breakEvenShortStop) : initialShortStop
    activeStop := trailingArmed ? math.min(activeStop, trailingShortStop) : activeStop
    activeTarget := strategy.position_avg_price - entryRiskDistance * rewardRiskRatio
    strategy.exit("SHORT EXIT", from_entry="SHORT", stop=activeStop, limit=activeTarget)

barsInTrade = na(tradeEntryBar) ? 0 : bar_index - tradeEntryBar
if enableStrategyOrders and maxTradeBars > 0 and strategy.position_size > 0 and barsInTrade >= maxTradeBars
    strategy.close("LONG", comment="Sortie temps")

if enableStrategyOrders and maxTradeBars > 0 and strategy.position_size < 0 and barsInTrade >= maxTradeBars
    strategy.close("SHORT", comment="Sortie temps")

if strategy.position_size == 0
    entryRiskDistance := na
    highestSinceEntry := na
    lowestSinceEntry := na
    tradeEntryBar := na
    breakEvenArmed := false
    trailingArmed := false

//====================================================
// VISUALS
//====================================================
plot(emaFast, "EMA 9", color=color.new(color.lime, 0), linewidth=2)
plot(emaSlow, "EMA 21", color=color.new(color.orange, 0), linewidth=2)
plot(useTrendFilter ? emaTrend : na, "EMA 200", color=color.new(color.blue, 0), linewidth=2)
plot(enableStrategyOrders ? activeStop : na, "Stop actif", color=color.new(color.red, 0), linewidth=2, style=plot.style_linebr)
plot(enableStrategyOrders ? activeTarget : na, "Objectif actif", color=color.new(color.aqua, 0), linewidth=2, style=plot.style_linebr)

// Distinguer visuellement le croisement EMA initial des autres types de BUY.
bullEmaCrossSignal = bullSignal and (bullCross or bullCrossRaw)
bullOtherBuySignal = bullSignal and not bullEmaCrossSignal
bearEmaCrossSignal = bearSignal and (bearCross or bearCrossRaw)
bearOtherSellSignal = bearSignal and not bearEmaCrossSignal

plotshape(showSignals and bullEmaCrossSignal,
     title="Signal croisement haussier EMA 9/21",
     style=shape.labelup,
     location=location.belowbar,
     color=color.new(color.lime, 0),
     text="CROSS 9/21",
     textcolor=color.black,
     size=size.tiny)

plotshape(showSignals and bullOtherBuySignal,
     title="Autre signal BUY",
     style=shape.labelup,
     location=location.belowbar,
     color=color.new(color.lime, 0),
     text="BUY",
     textcolor=color.black,
     size=size.tiny)

plotshape(showSignals and bearEmaCrossSignal,
     title="Signal croisement baissier EMA 9/21",
     style=shape.labeldown,
     location=location.abovebar,
     color=color.new(color.red, 0),
     text="CROSS 9/21",
     textcolor=color.white,
     size=size.tiny)

plotshape(showSignals and bearOtherSellSignal,
     title="Autre signal SELL",
     style=shape.labeldown,
     location=location.abovebar,
     color=color.new(color.red, 0),
     text="SELL",
     textcolor=color.white,
     size=size.tiny)

plotshape(blockedBullCross,
     title="Croisement haussier bloque",
     style=shape.circle,
     location=location.belowbar,
     color=color.new(color.lime, 65),
     size=size.tiny)

plotshape(blockedBearCross,
     title="Croisement baissier bloque",
     style=shape.circle,
     location=location.abovebar,
     color=color.new(color.red, 65),
     size=size.tiny)

bgcolor(showBackground ? (bullTrend ? color.new(color.green, 94) : bearTrend ? color.new(color.red, 94) : na) : na)

//====================================================
// TABLEAU SIMPLE
//====================================================
panelPosition = panelCorner == "Top Left" ? position.top_left : panelCorner == "Bottom Right" ? position.bottom_right : panelCorner == "Bottom Left" ? position.bottom_left : position.top_right
var table infoTable = table.new(panelPosition, 2, 8, bgcolor=color.new(color.black, 10), frame_width=1, frame_color=color.gray, border_width=1, border_color=color.new(color.gray, 35))

if showInfoPanel and barstate.islast
    table.cell(infoTable, 0, 0, "Signal actuel", text_color=color.white, bgcolor=color.new(color.blue, 35), text_size=size.small)
    table.cell(infoTable, 1, 0, panelSignalText, text_color=color.white, bgcolor=color.new(panelSignalColor, 25), text_size=size.small)
    table.cell(infoTable, 0, 1, "EMA " + str.tostring(emaFastLen), text_color=color.white, bgcolor=color.new(color.black, 20), text_size=size.small)
    table.cell(infoTable, 1, 1, str.tostring(emaFast, format.mintick), text_color=color.lime, bgcolor=color.new(color.black, 20), text_size=size.small)
    table.cell(infoTable, 0, 2, "EMA " + str.tostring(emaSlowLen), text_color=color.white, bgcolor=color.new(color.black, 20), text_size=size.small)
    table.cell(infoTable, 1, 2, str.tostring(emaSlow, format.mintick), text_color=color.orange, bgcolor=color.new(color.black, 20), text_size=size.small)
    table.cell(infoTable, 0, 3, "Tendance", text_color=color.white, bgcolor=color.new(color.black, 20), text_size=size.small)
    table.cell(infoTable, 1, 3, trendText, text_color=trendColor, bgcolor=color.new(color.black, 20), text_size=size.small)
    table.cell(infoTable, 0, 4, "Dernier cross EMA", text_color=color.white, bgcolor=color.new(color.black, 20), text_size=size.small)
    table.cell(infoTable, 1, 4, lastRawCrossDisplay, text_color=lastRawCrossColor, bgcolor=color.new(color.black, 20), text_size=size.small)
    table.cell(infoTable, 0, 5, "Dernier signal", text_color=color.white, bgcolor=color.new(color.black, 20), text_size=size.small)
    table.cell(infoTable, 1, 5, validSignalNow ? signalText : lastSignalDisplay, text_color=validSignalNow ? signalColor : lastSignalColor, bgcolor=color.new(color.black, 20), text_size=size.small)
    table.cell(infoTable, 0, 6, "Ecart EMA 9/21", text_color=color.white, bgcolor=color.new(color.black, 20), text_size=size.small)
    table.cell(infoTable, 1, 6, str.tostring(math.round(emaDistancePct, 2)) + "%", text_color=trendColor, bgcolor=color.new(color.black, 20), text_size=size.small)
    table.cell(infoTable, 0, 7, "Filtre", text_color=color.white, bgcolor=color.new(color.black, 20), text_size=size.small)
    table.cell(infoTable, 1, 7, filterText, text_color=filterColor, bgcolor=color.new(color.black, 20), text_size=size.small)

if not showInfoPanel and barstate.islast
    table.clear(infoTable, 0, 0, 1, 7)

//====================================================
// ALERTES
//====================================================
// Une seule alerte TradingView couvre les BUY et les SELL.
// Dans TradingView, choisir : "alert() function calls only".
if bullSignal
    if confirmedSignalsOnly
        alert("BUY | " + syminfo.ticker + " | Unite: " + timeframe.period + " | Prix: " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)
    else
        alert("BUY | " + syminfo.ticker + " | Unite: " + timeframe.period + " | Prix: " + str.tostring(close, format.mintick), alert.freq_once_per_bar)

if bearSignal
    if confirmedSignalsOnly
        alert("SELL | " + syminfo.ticker + " | Unite: " + timeframe.period + " | Prix: " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)
    else
        alert("SELL | " + syminfo.ticker + " | Unite: " + timeframe.period + " | Prix: " + str.tostring(close, format.mintick), alert.freq_once_per_bar)
