//@version=5
strategy("BTC PRO V7 CLEAN VISUEL - SWING + SNIPER MTF",
     overlay=true,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=10,
     pyramiding=0,
     commission_type=strategy.commission.percent,
     commission_value=0.04,
     max_labels_count=200,
     max_lines_count=100,
     max_boxes_count=20)

//====================================================
// INPUTS
//====================================================
tfHTF            = input.timeframe("240", "Timeframe HTF")
emaFastLen       = input.int(20, "EMA Rapide Swing", minval=1)
emaSlowLen       = input.int(50, "EMA Lente Swing", minval=1)
emaTrendLen      = input.int(200, "EMA Tendance Swing", minval=1)

diLen            = input.int(14, "DI Length", minval=1)
adxSmooth        = input.int(14, "ADX Smoothing", minval=1)
adxMin           = input.float(20.0, "ADX minimum", step=0.5)

pivotLen         = input.int(3, "Pivot Length", minval=1)
pullbackLookback = input.int(3, "Lookback cassure", minval=1)
swingLookback    = input.int(10, "Swing stop lookback", minval=2)

tp1RR            = input.float(2.0, "TP1 RR", step=0.1)
tp2RR            = input.float(4.0, "TP2 RR", step=0.1)

cooldownBars     = input.int(10, "Cooldown", minval=1)

maxFastDistPct   = input.float(0.60, "Distance max EMA rapide (%)", step=0.01)
maxSlowDistPct   = input.float(1.20, "Distance max EMA lente (%)", step=0.01)

pullbackTolerancePct = input.float(0.20, "Tolérance EMA pullback (%)", step=0.01)
minRetraceBars       = input.int(1, "Bars mini retracement", minval=1)
maxRetraceBars       = input.int(8, "Bars max retracement", minval=1)

sniperMode       = input.bool(true, "SNIPER MODE")
sniperBarsWindow = input.int(12, "Fenêtre max après CHOCH", minval=1)
sniperSlopeLen   = input.int(5, "Pente EMA lookback", minval=1)
institutionalMode = input.bool(true, "Institutional Setup")
sweepLookback      = input.int(12, "Lookback sweep liquidite", minval=2)
retestWindowBars   = input.int(8, "Fenetre retest breakout", minval=1)
retestAtrTolerance = input.float(0.45, "Tolerance retest ATR", minval=0.05, step=0.05)
minQualityScore    = input.int(5, "Score qualite minimum", minval=3, maxval=7)

cleanTradingMode = input.bool(true, "Mode clean trading")
showStructure    = input.bool(true, "Afficher HH/HL/LH/LL")
showSignals      = input.bool(true, "Afficher LONG / SHORT")
showBOSCHOCH     = input.bool(true, "Afficher CHOCH / BOS")
showPDZones      = input.bool(true, "Afficher Premium / Discount")
showSRZones      = input.bool(true, "Afficher zones Support / Resistance")
srZoneAtrMult    = input.float(0.35, "Largeur zone S/R ATR", minval=0.05, step=0.05)
srExtendBars     = input.int(80, "Extension zones S/R", minval=10, maxval=500)
showHTFBg        = input.bool(true, "Colorer fond HTF")
showPullback     = input.bool(true, "Afficher Pullback Detector")
showHTFLabel     = input.bool(false, "Afficher label HTF")
showBOSAsShapes  = input.bool(true, "BOS en symbole")
showChochLabels  = input.bool(false, "CHOCH en label")
showInfoPanel    = input.bool(true, "Afficher panneau diagnostic")
enableSignalAlert = input.bool(true, "Activer alerte signal")
panelCorner      = input.string("Top Right", "Position panneau", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"])

//====================================================
// LOCAL EMA / DMI
//====================================================
emaFast  = ta.ema(close, emaFastLen)
emaSlow  = ta.ema(close, emaSlowLen)
emaTrend = ta.ema(close, emaTrendLen)
atrValue = ta.atr(14)

[diplus, diminus, adx] = ta.dmi(diLen, adxSmooth)

//====================================================
// HTF DATA
//====================================================
f_htf_data() =>
    [_diPlus, _diMinus, _adx] = ta.dmi(diLen, adxSmooth)
    [close, ta.ema(close, emaFastLen), ta.ema(close, emaSlowLen), ta.ema(close, emaTrendLen), _adx, _diPlus, _diMinus]

[htfClose, htfEmaFast, htfEmaSlow, htfEmaTrend, htfAdx, htfDiPlus, htfDiMinus] = request.security(syminfo.tickerid, tfHTF, f_htf_data())

htfBull = htfClose > htfEmaTrend and htfEmaFast > htfEmaSlow and htfAdx > adxMin and htfDiPlus > htfDiMinus
htfBear = htfClose < htfEmaTrend and htfEmaFast < htfEmaSlow and htfAdx > adxMin and htfDiMinus > htfDiPlus

htfBgTransparency = cleanTradingMode ? 97 : 94
bgcolor(showHTFBg ? (htfBull ? color.new(color.green, htfBgTransparency) : htfBear ? color.new(color.red, htfBgTransparency) : na) : na)

//====================================================
// ANTI-EXTENSION
//====================================================
distFastLong  = ((close - emaFast) / emaFast) * 100.0
distSlowLong  = ((close - emaSlow) / emaSlow) * 100.0
distFastShort = ((emaFast - close) / emaFast) * 100.0
distSlowShort = ((emaSlow - close) / emaSlow) * 100.0

notTooExtendedLong  = distFastLong <= maxFastDistPct and distSlowLong <= maxSlowDistPct
notTooExtendedShort = distFastShort <= maxFastDistPct and distSlowShort <= maxSlowDistPct

//====================================================
// PIVOTS / STRUCTURE
//====================================================
ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low, pivotLen, pivotLen)

var float prevHighPivot = na
var float prevLowPivot  = na
var float lastHighPivot = na
var float lastLowPivot  = na
var int lastHighPivotBar = na
var int lastLowPivotBar = na

highPivotReady = not na(ph)
lowPivotReady = not na(pl)

hhSignal = highPivotReady and not na(prevHighPivot) and ph > prevHighPivot
lhSignal = highPivotReady and not na(prevHighPivot) and ph <= prevHighPivot

hlSignal = lowPivotReady and not na(prevLowPivot) and pl > prevLowPivot
llSignal = lowPivotReady and not na(prevLowPivot) and pl <= prevLowPivot

showStructureVisual = showStructure

plotshape(showStructureVisual and hhSignal, title="HH", style=shape.labeldown, location=location.abovebar, offset=-pivotLen, color=color.new(color.green, 0), text="HH", textcolor=color.white, size=size.tiny)
plotshape(showStructureVisual and lhSignal, title="LH", style=shape.labeldown, location=location.abovebar, offset=-pivotLen, color=color.new(color.orange, 0), text="LH", textcolor=color.white, size=size.tiny)
plotshape(showStructureVisual and hlSignal, title="HL", style=shape.labelup, location=location.belowbar, offset=-pivotLen, color=color.new(color.teal, 0), text="HL", textcolor=color.white, size=size.tiny)
plotshape(showStructureVisual and llSignal, title="LL", style=shape.labelup, location=location.belowbar, offset=-pivotLen, color=color.new(color.red, 0), text="LL", textcolor=color.white, size=size.tiny)

if highPivotReady
    lastHighPivot := ph
    lastHighPivotBar := bar_index - pivotLen
    prevHighPivot := ph

if lowPivotReady
    lastLowPivot := pl
    lastLowPivotBar := bar_index - pivotLen
    prevLowPivot := pl

//====================================================
// SUPPORT / RESISTANCE ZONES
//====================================================
var box resistanceBox = na
var box supportBox = na

srZoneHalfWidth = atrValue * srZoneAtrMult
srRight = bar_index + srExtendBars

if showSRZones and highPivotReady
    if not na(resistanceBox)
        box.delete(resistanceBox)
    resistanceBox := box.new(
         left=lastHighPivotBar,
         top=lastHighPivot + srZoneHalfWidth,
         right=srRight,
         bottom=lastHighPivot - srZoneHalfWidth,
         bgcolor=color.new(color.red, cleanTradingMode ? 92 : 88),
         border_color=color.new(color.red, cleanTradingMode ? 45 : 25),
         text="Resistance",
         text_color=color.new(color.red, 0),
         text_size=size.tiny)

if showSRZones and lowPivotReady
    if not na(supportBox)
        box.delete(supportBox)
    supportBox := box.new(
         left=lastLowPivotBar,
         top=lastLowPivot + srZoneHalfWidth,
         right=srRight,
         bottom=lastLowPivot - srZoneHalfWidth,
         bgcolor=color.new(color.lime, cleanTradingMode ? 93 : 89),
         border_color=color.new(color.lime, cleanTradingMode ? 45 : 25),
         text="Support",
         text_color=color.new(color.lime, 0),
         text_size=size.tiny)

if showSRZones and barstate.islast
    if not na(resistanceBox)
        box.set_right(resistanceBox, srRight)
    if not na(supportBox)
        box.set_right(supportBox, srRight)

if not showSRZones and barstate.islast
    if not na(resistanceBox)
        box.delete(resistanceBox)
        resistanceBox := na
    if not na(supportBox)
        box.delete(supportBox)
        supportBox := na

//====================================================
// STRUCTURE STATE / CHOCH / BOS
//====================================================
var int structureBias = 0
var int lastChochBar = na

bullBreak = not na(lastHighPivot) and close > lastHighPivot and close[1] <= lastHighPivot
bearBreak = not na(lastLowPivot) and close < lastLowPivot and close[1] >= lastLowPivot

chochBull = bullBreak and structureBias <= 0
chochBear = bearBreak and structureBias >= 0

bosBull = bullBreak and structureBias == 1
bosBear = bearBreak and structureBias == -1

if chochBull
    structureBias := 1
    lastChochBar := bar_index

if chochBear
    structureBias := -1
    lastChochBar := bar_index

if bosBull
    structureBias := 1

if bosBear
    structureBias := -1

showChochVisual = showBOSCHOCH and showChochLabels and not cleanTradingMode
showBOSVisual = showBOSCHOCH and showBOSAsShapes and not cleanTradingMode

plotshape(showChochVisual and chochBull, title="CHOCH Bull", style=shape.labelup, location=location.abovebar, color=color.new(color.lime, 0), size=size.tiny, text="CH", textcolor=color.white)
plotshape(showChochVisual and chochBear, title="CHOCH Bear", style=shape.labeldown, location=location.belowbar, color=color.new(color.red, 0), size=size.tiny, text="CH", textcolor=color.white)
plotshape(showBOSVisual and bosBull, title="BOS Bull", style=shape.triangleup, location=location.abovebar, color=color.new(color.green, 35), size=size.tiny, text="", textcolor=color.white)
plotshape(showBOSVisual and bosBear, title="BOS Bear", style=shape.triangledown, location=location.belowbar, color=color.new(color.red, 35), size=size.tiny, text="", textcolor=color.white)

//====================================================
// PREMIUM / DISCOUNT
//====================================================
var float dealingHigh = na
var float dealingLow  = na

if not na(lastHighPivot) and not na(lastLowPivot)
    dealingHigh := math.max(lastHighPivot, lastLowPivot)
    dealingLow  := math.min(lastHighPivot, lastLowPivot)

eq = not na(dealingHigh) and not na(dealingLow) ? (dealingHigh + dealingLow) / 2.0 : na

inDiscount = not na(eq) and close < eq
inPremium  = not na(eq) and close > eq
nearEquilibrium = not na(eq) and math.abs(close - eq) / close * 100 < 0.20

zoneTransparency = cleanTradingMode ? 88 : 78
eqTransparency = cleanTradingMode ? 75 : 60

plot(showPDZones ? dealingHigh : na, "Premium High", color=color.new(color.red, zoneTransparency), linewidth=1, style=plot.style_linebr)
plot(showPDZones ? dealingLow  : na, "Discount Low", color=color.new(color.green, zoneTransparency), linewidth=1, style=plot.style_linebr)
plot(showPDZones ? eq          : na, "Equilibrium", color=color.new(color.yellow, eqTransparency), linewidth=1, style=plot.style_linebr)

//====================================================
// REAL PULLBACK DETECTOR
//====================================================
distToFast = math.abs(close - emaFast) / close * 100.0
distToSlow = math.abs(close - emaSlow) / close * 100.0

nearFast = distToFast <= pullbackTolerancePct
nearSlow = distToSlow <= pullbackTolerancePct
nearEMA  = nearFast or nearSlow

recentRedBars   = ta.barssince(close < open)
recentGreenBars = ta.barssince(close > open)

realPullbackLong =
     structureBias == 1 and
     emaFast > emaSlow and
     nearEMA and
     low <= emaFast and
     close >= emaFast and
     recentRedBars >= minRetraceBars and
     recentRedBars <= maxRetraceBars and
     close > emaSlow

realPullbackShort =
     structureBias == -1 and
     emaFast < emaSlow and
     nearEMA and
     high >= emaFast and
     close <= emaFast and
     recentGreenBars >= minRetraceBars and
     recentGreenBars <= maxRetraceBars and
     close < emaSlow

plotshape(showPullback and realPullbackLong, title="PB LONG", style=shape.circle, location=location.belowbar, color=color.lime, size=size.tiny, text="", textcolor=color.blue)
plotshape(showPullback and realPullbackShort, title="PB SHORT", style=shape.circle, location=location.abovebar, color=color.red, size=size.tiny, text="", textcolor=color.blue)

//====================================================
// SNIPER MODE
//====================================================
barsSinceChoch = na(lastChochBar) ? 999 : bar_index - lastChochBar
sniperWindow   = barsSinceChoch <= sniperBarsWindow

emaSlopeFast = emaFast - emaFast[sniperSlopeLen]
emaSlopeSlow = emaSlow - emaSlow[sniperSlopeLen]

trendStrongLong  = emaSlopeFast > 0 and emaSlopeSlow > 0
trendStrongShort = emaSlopeFast < 0 and emaSlopeSlow < 0

var bool pullbackUsedLong = false
var bool pullbackUsedShort = false
flat = strategy.position_size == 0
positionJustClosed = strategy.position_size == 0 and nz(strategy.position_size[1]) != 0

if chochBull
    pullbackUsedLong := false
if chochBear
    pullbackUsedShort := false

firstPullbackLong  = realPullbackLong and not pullbackUsedLong
firstPullbackShort = realPullbackShort and not pullbackUsedShort

breakHigh = high > ta.highest(high[1], pullbackLookback)
breakLow  = low < ta.lowest(low[1], pullbackLookback)

var int lastEntryBar = na
canTrade = na(lastEntryBar) or (bar_index - lastEntryBar > cooldownBars)

//====================================================
// INSTITUTIONAL SETUPS
//====================================================
prevLiquidityLow = ta.lowest(low[1], sweepLookback)
prevLiquidityHigh = ta.highest(high[1], sweepLookback)
longSweep = low < prevLiquidityLow and close > prevLiquidityLow and close > open
shortSweep = high > prevLiquidityHigh and close < prevLiquidityHigh and close < open

var float brokenResistance = na
var float brokenSupport = na
var int lastBullBreakoutBar = na
var int lastBearBreakoutBar = na

if bullBreak
    brokenResistance := lastHighPivot
    lastBullBreakoutBar := bar_index

if bearBreak
    brokenSupport := lastLowPivot
    lastBearBreakoutBar := bar_index

longRetestActive = not na(brokenResistance) and not na(lastBullBreakoutBar) and bar_index > lastBullBreakoutBar and bar_index - lastBullBreakoutBar <= retestWindowBars
shortRetestActive = not na(brokenSupport) and not na(lastBearBreakoutBar) and bar_index > lastBearBreakoutBar and bar_index - lastBearBreakoutBar <= retestWindowBars

longRetestOk = longRetestActive and low <= brokenResistance + atrValue * retestAtrTolerance and close > brokenResistance and close > open
shortRetestOk = shortRetestActive and high >= brokenSupport - atrValue * retestAtrTolerance and close < brokenSupport and close < open

institutionalLongContext = htfBull and structureBias == 1 and emaFast > emaSlow
institutionalShortContext = htfBear and structureBias == -1 and emaFast < emaSlow

//====================================================
// CONDITIONS
//====================================================
longContext = htfBull and (structureBias == 1 or chochBull or bullBreak)
shortContext = htfBear and (structureBias == -1 or chochBear or bearBreak)

longLocationOk = inDiscount or nearEquilibrium
shortLocationOk = inPremium or nearEquilibrium

longConditionBase =
     longContext and
     longLocationOk and
     realPullbackLong and
     breakHigh and
     notTooExtendedLong and
     flat and
     canTrade

shortConditionBase =
     shortContext and
     shortLocationOk and
     realPullbackShort and
     breakLow and
     notTooExtendedShort and
     flat and
     canTrade

longConditionSniper =
     longContext and
     longLocationOk and
     firstPullbackLong and
     trendStrongLong and
     sniperWindow and
     breakHigh and
     notTooExtendedLong and
     flat and
     canTrade

shortConditionSniper =
     shortContext and
     shortLocationOk and
     firstPullbackShort and
     trendStrongShort and
     sniperWindow and
     breakLow and
     notTooExtendedShort and
     flat and
     canTrade

longQualityScore =
     (htfBull ? 1 : 0) +
     (structureBias == 1 ? 1 : 0) +
     (emaFast > emaSlow ? 1 : 0) +
     (longLocationOk or longRetestOk ? 1 : 0) +
     (realPullbackLong or longRetestOk or longSweep ? 1 : 0) +
     (breakHigh or longRetestOk ? 1 : 0) +
     (notTooExtendedLong ? 1 : 0)

shortQualityScore =
     (htfBear ? 1 : 0) +
     (structureBias == -1 ? 1 : 0) +
     (emaFast < emaSlow ? 1 : 0) +
     (shortLocationOk or shortRetestOk ? 1 : 0) +
     (realPullbackShort or shortRetestOk or shortSweep ? 1 : 0) +
     (breakLow or shortRetestOk ? 1 : 0) +
     (notTooExtendedShort ? 1 : 0)

longQualityOk = longQualityScore >= minQualityScore
shortQualityOk = shortQualityScore >= minQualityScore

longRetestCondition =
     institutionalMode and
     institutionalLongContext and
     longRetestOk and
     trendStrongLong and
     notTooExtendedLong and
     longQualityOk and
     flat and
     canTrade

shortRetestCondition =
     institutionalMode and
     institutionalShortContext and
     shortRetestOk and
     trendStrongShort and
     notTooExtendedShort and
     shortQualityOk and
     flat and
     canTrade

longSweepCondition =
     institutionalMode and
     institutionalLongContext and
     longSweep and
     breakHigh and
     notTooExtendedLong and
     longQualityOk and
     flat and
     canTrade

shortSweepCondition =
     institutionalMode and
     institutionalShortContext and
     shortSweep and
     breakLow and
     notTooExtendedShort and
     shortQualityOk and
     flat and
     canTrade

classicLongCondition = sniperMode ? longConditionSniper : longConditionBase
classicShortCondition = sniperMode ? shortConditionSniper : shortConditionBase

institutionalLongCondition = longRetestCondition or longSweepCondition
institutionalShortCondition = shortRetestCondition or shortSweepCondition

longCondition  = classicLongCondition or institutionalLongCondition
shortCondition = classicShortCondition or institutionalShortCondition

setupType =
     longRetestCondition ? "Long Retest" :
     shortRetestCondition ? "Short Retest" :
     longSweepCondition ? "Long Sweep" :
     shortSweepCondition ? "Short Sweep" :
     classicLongCondition ? "Long Pullback" :
     classicShortCondition ? "Short Pullback" :
     longRetestOk ? "Retest Long pret" :
     shortRetestOk ? "Retest Short pret" :
     longSweep ? "Sweep Long pret" :
     shortSweep ? "Sweep Short pret" :
     "Aucun"

signalEvent = longCondition or shortCondition
signalAlertType =
     longRetestCondition ? "LONG RETEST" :
     longSweepCondition ? "LONG SWEEP" :
     classicLongCondition ? "LONG PULLBACK" :
     shortRetestCondition ? "SHORT RETEST" :
     shortSweepCondition ? "SHORT SWEEP" :
     classicShortCondition ? "SHORT PULLBACK" :
     "AUCUN"
signalAlertMessage = "V7 SIGNAL " + signalAlertType + " | " + syminfo.ticker + " | TF " + timeframe.period + " | Prix " + str.tostring(close, format.mintick) + " | Qualite L " + str.tostring(longQualityScore) + "/7 S " + str.tostring(shortQualityScore) + "/7"

//====================================================
// DIAGNOSTIC PANEL
//====================================================
longPbOk = sniperMode ? firstPullbackLong : realPullbackLong
shortPbOk = sniperMode ? firstPullbackShort : realPullbackShort
longSlopeOk = not sniperMode or trendStrongLong
shortSlopeOk = not sniperMode or trendStrongShort
longSniperWindowOk = not sniperMode or sniperWindow
shortSniperWindowOk = not sniperMode or sniperWindow

watchLong = longCondition or htfBull or longContext or realPullbackLong
watchShort = shortCondition or htfBear or shortContext or realPullbackShort
preferLong = watchLong and (not watchShort or structureBias >= 0)
preferShort = watchShort and not preferLong
qualityScore = preferLong ? longQualityScore : preferShort ? shortQualityScore : math.max(longQualityScore, shortQualityScore)
qualityText = qualityScore >= 7 ? "A+" : qualityScore >= 6 ? "A" : qualityScore >= 5 ? "B" : "Aucun"

longBlocker =
     longCondition ? "OK LONG" :
     not htfBull ? "HTF" :
     not longContext ? "Structure" :
     not longLocationOk and not longRetestOk ? "Zone" :
     not longPbOk and not longRetestOk and not longSweep ? "Pullback/Retest/Sweep" :
     not longSlopeOk ? "Pente EMA" :
     not longSniperWindowOk and not longRetestOk and not longSweep ? "Fenetre CHOCH" :
     not breakHigh and not longRetestOk ? "Cassure high" :
     not notTooExtendedLong ? "Extension" :
     not longQualityOk ? "Qualite" :
     not flat ? "Deja en trade" :
     not canTrade ? "Cooldown" :
     "Attente"

shortBlocker =
     shortCondition ? "OK SHORT" :
     not htfBear ? "HTF" :
     not shortContext ? "Structure" :
     not shortLocationOk and not shortRetestOk ? "Zone" :
     not shortPbOk and not shortRetestOk and not shortSweep ? "Pullback/Retest/Sweep" :
     not shortSlopeOk ? "Pente EMA" :
     not shortSniperWindowOk and not shortRetestOk and not shortSweep ? "Fenetre CHOCH" :
     not breakLow and not shortRetestOk ? "Cassure low" :
     not notTooExtendedShort ? "Extension" :
     not shortQualityOk ? "Qualite" :
     not flat ? "Deja en trade" :
     not canTrade ? "Cooldown" :
     "Attente"

setupText =
     longCondition ? "Entree LONG" :
     shortCondition ? "Entree SHORT" :
     longRetestOk ? "Retest Long" :
     shortRetestOk ? "Retest Short" :
     longSweep ? "Sweep Long" :
     shortSweep ? "Sweep Short" :
     preferLong ? (longPbOk ? "PB Long" : "Surveille Long") :
     preferShort ? (shortPbOk ? "PB Short" : "Surveille Short") :
     "Aucun"

blockerText =
     longCondition or shortCondition ? "OK" :
     preferLong ? longBlocker :
     preferShort ? shortBlocker :
     "Pas de setup"

panelPosition = panelCorner == "Top Left" ? position.top_left : panelCorner == "Bottom Right" ? position.bottom_right : panelCorner == "Bottom Left" ? position.bottom_left : position.top_right
var table infoTable = table.new(panelPosition, 2, 10, bgcolor=color.new(color.black, 84), border_width=1, border_color=color.gray)

drawInfoPanel = showInfoPanel and (barstate.islast or barstate.islastconfirmedhistory)

if drawInfoPanel
    htfText = htfBull ? "Bullish" : htfBear ? "Bearish" : "Neutre"
    htfColor = htfBull ? color.lime : htfBear ? color.red : color.gray
    structureText = structureBias == 1 ? "Haussiere" : structureBias == -1 ? "Baissiere" : "Neutre"
    structureColor = structureBias == 1 ? color.lime : structureBias == -1 ? color.red : color.yellow
    zoneText = inDiscount ? "Discount" : inPremium ? "Premium" : "Equilibre"
    zoneColor = inDiscount ? color.lime : inPremium ? color.red : color.yellow
    pbText = realPullbackLong ? "PB Long" : realPullbackShort ? "PB Short" : "Aucun"
    pbColor = realPullbackLong ? color.lime : realPullbackShort ? color.red : color.gray
    setupColor = longCondition or setupText == "PB Long" or setupText == "Surveille Long" or setupText == "Retest Long" or setupText == "Sweep Long" ? color.lime : shortCondition or setupText == "PB Short" or setupText == "Surveille Short" or setupText == "Retest Short" or setupText == "Sweep Short" ? color.red : color.gray
    blockerColor = blockerText == "OK" ? color.lime : blockerText == "Pas de setup" ? color.gray : color.orange
    typeColor = str.contains(setupType, "Long") ? color.lime : str.contains(setupType, "Short") ? color.red : color.gray
    qualityColor = qualityText == "A+" ? color.lime : qualityText == "A" ? color.aqua : qualityText == "B" ? color.yellow : color.gray
    signalText = longRetestCondition ? "LONG Retest" : longSweepCondition ? "LONG Sweep" : classicLongCondition ? "LONG" : shortRetestCondition ? "SHORT Retest" : shortSweepCondition ? "SHORT Sweep" : classicShortCondition ? "SHORT" : "Aucun"
    signalColor = longCondition ? color.lime : shortCondition ? color.red : color.gray

    table.cell(infoTable, 0, 0, "Indicateur", text_color=color.white, bgcolor=color.new(color.blue, 65))
    table.cell(infoTable, 1, 0, "Valeur", text_color=color.white, bgcolor=color.new(color.blue, 65))
    table.cell(infoTable, 0, 1, "HTF " + tfHTF, text_color=color.white)
    table.cell(infoTable, 1, 1, htfText, text_color=htfColor)
    table.cell(infoTable, 0, 2, "Structure", text_color=color.white)
    table.cell(infoTable, 1, 2, structureText, text_color=structureColor)
    table.cell(infoTable, 0, 3, "Zone", text_color=color.white)
    table.cell(infoTable, 1, 3, zoneText, text_color=zoneColor)
    table.cell(infoTable, 0, 4, "Pullback", text_color=color.white)
    table.cell(infoTable, 1, 4, pbText, text_color=pbColor)
    table.cell(infoTable, 0, 5, "Setup", text_color=color.white)
    table.cell(infoTable, 1, 5, setupText, text_color=setupColor)
    table.cell(infoTable, 0, 6, "Blocage", text_color=color.white)
    table.cell(infoTable, 1, 6, blockerText, text_color=blockerColor)
    table.cell(infoTable, 0, 7, "Type", text_color=color.white)
    table.cell(infoTable, 1, 7, setupType, text_color=typeColor)
