//@version=5
indicator("EMA 9/21 Simple BUY SELL", overlay=true, max_labels_count=500)

// Parametres simples
fastLength = input.int(9, "EMA rapide", minval=1)
slowLength = input.int(21, "EMA lente", minval=2)
trendLength = input.int(200, "EMA tendance", minval=20)
signalMode = input.string("Sniper", "Mode signaux", options=["Simple", "Normal", "Sniper"])
useTrendFilter = input.bool(true, "Filtrer avec EMA tendance")
useSlopeFilter = input.bool(false, "Confirmer la pente EMA 21")
slopeLookback = input.int(3, "Pente (bougies)", minval=1)
cooldownBars = input.int(10, "Pause entre signaux (bougies)", minval=0)
confirmNextCandle = input.bool(true, "Confirmer sur la bougie suivante")
usePullbackSignals = input.bool(true, "Signaux de rebond EMA")
pullbackTolerancePct = input.float(0.15, "Tolerance rebond EMA (%)", minval=0.05, step=0.05)
minEmaGapPct = input.float(0.02, "Ecart minimum EMA 9/21 (%)", minval=0, step=0.01)
useRsiFilter = input.bool(true, "Filtrer avec RSI 50")
rsiLength = input.int(14, "RSI longueur", minval=2)
showBackground = input.bool(false, "Colorer la tendance")
showPanel = input.bool(true, "Afficher le tableau")

// Moyennes mobiles
emaFast = ta.ema(close, fastLength)
emaSlow = ta.ema(close, slowLength)
emaTrend = ta.ema(close, trendLength)
rsiValue = ta.rsi(close, rsiLength)
[diPlus, diMinus, adxValue] = ta.dmi(14, 14)

// Signal uniquement a la cloture de la bougie : aucun repaint intrabar.
rawBuyCross = barstate.isconfirmed and ta.crossover(emaFast, emaSlow)
rawSellCross = barstate.isconfirmed and ta.crossunder(emaFast, emaSlow)
trendBuyOk = not useTrendFilter or close > emaTrend
trendSellOk = not useTrendFilter or close < emaTrend
slopeBuyOk = not useSlopeFilter or emaSlow > emaSlow[slopeLookback]
slopeSellOk = not useSlopeFilter or emaSlow < emaSlow[slopeLookback]
var int lastSignalBar = na
cooldownOk = na(lastSignalBar) or bar_index - lastSignalBar > cooldownBars
buyTrigger = confirmNextCandle ? rawBuyCross[1] and close > open and close > emaFast : rawBuyCross
sellTrigger = confirmNextCandle ? rawSellCross[1] and close < open and close < emaFast : rawSellCross

pullbackTolerance = pullbackTolerancePct / 100
emaGapPct = close != 0 ? math.abs(emaFast - emaSlow) / close * 100 : 0
emaGapOk = emaGapPct >= minEmaGapPct
upTrend = close > emaTrend and emaFast > emaSlow
downTrend = close < emaTrend and emaFast < emaSlow
buyPullback = usePullbackSignals and upTrend and low <= emaSlow * (1 + pullbackTolerance) and close > emaFast and close > open and close > high[1]
sellPullback = usePullbackSignals and downTrend and high >= emaSlow * (1 - pullbackTolerance) and close < emaFast and close < open and close < low[1]
buyRsiOk = not useRsiFilter or rsiValue > 50
sellRsiOk = not useRsiFilter or rsiValue < 50

normalBuySignal = (buyTrigger or buyPullback) and trendBuyOk and slopeBuyOk and buyRsiOk and emaGapOk and cooldownOk
normalSellSignal = (sellTrigger or sellPullback) and trendSellOk and slopeSellOk and sellRsiOk and emaGapOk and cooldownOk

// Mode sniper : une configuration rare, alignee et confirmee par momentum.
sniperGapOk = emaGapPct >= math.max(minEmaGapPct, 0.05)
sniperBuyOk = trendBuyOk and close > emaTrend and emaSlow > emaSlow[slopeLookback] and rsiValue >= 55 and diPlus > diMinus and adxValue >= 20 and close > high[1] and sniperGapOk
sniperSellOk = trendSellOk and close < emaTrend and emaSlow < emaSlow[slopeLookback] and rsiValue <= 45 and diMinus > diPlus and adxValue >= 20 and close < low[1] and sniperGapOk

simpleBuySignal = (rawBuyCross or buyPullback) and cooldownOk
simpleSellSignal = (rawSellCross or sellPullback) and cooldownOk
buySignal = signalMode == "Simple" ? simpleBuySignal : signalMode == "Sniper" ? (buyTrigger or buyPullback) and sniperBuyOk and cooldownOk : normalBuySignal
sellSignal = signalMode == "Simple" ? simpleSellSignal : signalMode == "Sniper" ? (sellTrigger or sellPullback) and sniperSellOk and cooldownOk : normalSellSignal

if buySignal or sellSignal
    lastSignalBar := bar_index

plot(emaFast, "EMA rapide", color=color.aqua, linewidth=2)
plot(emaSlow, "EMA lente", color=color.orange, linewidth=2)
plot(emaTrend, "EMA tendance", color=color.purple, linewidth=2)

bgcolor(showBackground ? emaFast > emaSlow ? color.new(color.green, 92) : color.new(color.red, 92) : na)

plotshape(buySignal, title="BUY", style=shape.labelup, location=location.belowbar,
     color=color.lime, text="BUY", textcolor=color.black, size=size.small)
plotshape(sellSignal, title="SELL", style=shape.labeldown, location=location.abovebar,
     color=color.red, text="SELL", textcolor=color.white, size=size.small)

alertcondition(buySignal, title="BUY EMA 9/21", message="BUY : EMA rapide au-dessus de l'EMA lente sur {{ticker}}")
alertcondition(sellSignal, title="SELL EMA 9/21", message="SELL : EMA rapide sous l'EMA lente sur {{ticker}}")

// Tableau simple : cet indicateur ne gere pas de positions ni de backtest.
var table panel = table.new(position.top_right, 2, 9,
     bgcolor=color.new(color.black, 82), border_width=1,
     border_color=color.new(color.gray, 40))

if showPanel and barstate.islast
    trendBull = close > emaTrend
    trendText = trendBull ? "Haussiere" : "Baissiere"
    trendColor = trendBull ? color.lime : color.red
    signalText = buySignal ? "BUY" : sellSignal ? "SELL" : "Attente"
    signalColor = buySignal ? color.lime : sellSignal ? color.red : color.gray

    table.cell(panel, 0, 0, "EMA Simple", text_color=color.white, bgcolor=color.new(color.blue, 55))
    table.cell(panel, 1, 0, syminfo.ticker, text_color=color.white, bgcolor=color.new(color.blue, 55))
    table.cell(panel, 0, 1, "Timeframe", text_color=color.white)
    table.cell(panel, 1, 1, timeframe.period == "1" ? "1M OK" : timeframe.period, text_color=timeframe.period == "1" ? color.lime : color.orange)
    table.cell(panel, 0, 2, "Tendance", text_color=color.white)
    table.cell(panel, 1, 2, trendText, text_color=trendColor)
    table.cell(panel, 0, 3, "Signal", text_color=color.white)
    table.cell(panel, 1, 3, signalText, text_color=signalColor)
    table.cell(panel, 0, 4, "EMA 9", text_color=color.white)
    table.cell(panel, 1, 4, str.tostring(emaFast, format.mintick), text_color=color.aqua)
    table.cell(panel, 0, 5, "EMA 21", text_color=color.white)
    table.cell(panel, 1, 5, str.tostring(emaSlow, format.mintick), text_color=color.orange)
    table.cell(panel, 0, 6, "Ecart EMA", text_color=color.white)
    table.cell(panel, 1, 6, str.tostring(emaGapPct, "#.###") + "%", text_color=emaGapOk ? color.lime : color.gray)
    table.cell(panel, 0, 7, "RSI", text_color=color.white)
    table.cell(panel, 1, 7, str.tostring(rsiValue, "#.0"), text_color=color.white)
    table.cell(panel, 0, 8, "Mode", text_color=color.white)
    table.cell(panel, 1, 8, signalMode, text_color=signalMode == "Sniper" ? color.yellow : color.gray)

if not showPanel and barstate.islast
    table.clear(panel, 0, 0, 1, 8)
